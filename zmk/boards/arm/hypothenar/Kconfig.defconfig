# SPDX-License-Identifier: MIT

if BOARD_HYPOTHENAR

config BOARD
    default "hypothenar"

# ZMK_USB / ZMK_BLE are deliberately NOT defaulted here: ZMK's own
# role-aware defaults enable USB HID only on the central half.
# Forcing ZMK_USB=y board-wide makes the peripheral link against
# central-only HID report code and fails.

# On-chip BLE controller (same pattern as upstream nice_nano). Without
# this the build falls back to the H4 UART HCI transport and fails on
# the missing zephyr,bt-uart chosen. NOTE: do not add a default for
# BT_LL_SW_SPLIT - it is a choice symbol and Kconfig aborts on it.
config BT_CTLR
    default BT

endif # BOARD_HYPOTHENAR
