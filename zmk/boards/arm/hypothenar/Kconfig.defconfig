# SPDX-License-Identifier: MIT

if BOARD_HYPOTHENAR

config BOARD
    default "hypothenar"

config ZMK_BLE
    default y

config ZMK_USB
    default y

# Bluetooth-only is a battery saver - USB transport stays available
# for keymap flashing but the radio is the primary path.
config BT_CTLR
    default y

config BT_LL_SW_SPLIT
    default y

endif # BOARD_HYPOTHENAR
