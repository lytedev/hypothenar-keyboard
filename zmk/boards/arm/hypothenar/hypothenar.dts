// SPDX-License-Identifier: MIT
//
// Hypothenar: MS88SF3-nRF52840 module on a custom keyboard PCB.
//
// Pin assignments are keyed off ergogen/config.yaml's MS88SF3 pad map. The
// nRF52840 GPIOs used below (I2C SDA=P0.26 / SCL=P0.27, I2C_RESET=P0.31,
// INTA MCP_A=P0.30 / MCP_B=P0.02, BATT_ADC=P0.04 / enable P0.05, encoder
// A=P0.29 / B=P0.28, SWD, USB) must match the ergogen pad->net assignments
// pad-for-pad. THE MS88SF3 PAD->nRF52840-PIN MAP IS NOT YET DATASHEET-
// VERIFIED (config.yaml says so): confirm every pad against the Minew
// MS88SF3 rev-K datasheet before fabbing, and keep this file and
// ergogen/config.yaml in lockstep. (The old comment here listed
// P14=USB_DP/P20=I2C_SCL/etc. - that was stale and WRONG; deleted.)

/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include "hypothenar-pinctrl.dtsi"

/ {
    model = "Hypothenar";
    compatible = "thenar,hypothenar";

    chosen {
        zephyr,code-partition = &code_partition;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,console = &cdc_acm_uart;
        zephyr,uart-mcumgr = &cdc_acm_uart;
        zephyr,bt-mon-uart = &cdc_acm_uart;
        zephyr,bt-c2h-uart = &cdc_acm_uart;
        zephyr,uart-pipe = &cdc_acm_uart;
        zmk,battery = &vbatt;
    };

    // Battery voltage divider on a SAADC channel. Update the gpios pin
    // once the PCB routing pins this to a specific MS88SF3 pad.
    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 2>;  // AIN2 = P0.04, MS88SF3 pad 16
        output-ohms = <2000000>;
        full-ohms = <(2000000 + 820000)>;
        power-gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;  // P0.05, pad 15
    };
};

&adc {
    status = "okay";
};

&gpiote {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

// I2C bus used for the two MCP23017 expanders. Default to 400 kHz; bump
// to 1 MHz only after smoke testing.
&i2c0 {
    compatible = "nordic,nrf-twi";
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    mcp_a: mcp23017@20 {
        compatible = "microchip,mcp230xx";
        status = "okay";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <16>;
        // RESET is a board-wide net wired to a single MCU GPIO; both
        // expanders share it. The driver pulses it on init.
        reset-gpios = <&gpio0 31 GPIO_ACTIVE_LOW>;  // I2C_RESET = P0.31, pad 13
        // Wake-on-keychange: INTA (MIRROR mode) -> P0.30 (pad 12).
        // Lets the kscan sleep between keys instead of polling I2C.
        int-gpios = <&gpio0 30 GPIO_ACTIVE_LOW>;
    };

    mcp_b: mcp23017@21 {
        compatible = "microchip,mcp230xx";
        status = "okay";
        reg = <0x21>;
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <16>;
        // reset-gpios omitted - same net is owned by mcp_a's binding.
        int-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;  // INTA -> P0.02 (pad 9)
    };
};

&usbd {
    status = "okay";
    cdc_acm_uart: cdc_acm_uart {
        compatible = "zephyr,cdc-acm-uart";
    };
};

zephyr_udc0: &usbd {
    status = "okay";
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        // Match nice_nano_v2 / Adafruit nRF52 bootloader layout so the
        // same UF2 path works.
        sd_partition: partition@0 {
            label = "softdevice";
            reg = <0x00000000 0x00026000>;
        };
        code_partition: partition@26000 {
            label = "code_partition";
            reg = <0x00026000 0x000c6000>;
        };
        storage_partition: partition@ec000 {
            label = "storage";
            reg = <0x000ec000 0x00008000>;
        };
        boot_partition: partition@f4000 {
            label = "adafruit_boot";
            reg = <0x000f4000 0x0000c000>;
        };
    };
};

