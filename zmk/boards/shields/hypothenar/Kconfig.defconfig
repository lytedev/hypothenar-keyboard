if SHIELD_HYPOTHENAR_LEFT

config ZMK_KEYBOARD_NAME
    default "Hypothenar"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_HYPOTHENAR_LEFT || SHIELD_HYPOTHENAR_RIGHT

config ZMK_SPLIT
    default y

# MCP23017 driver belongs to the Zephyr GPIO subsystem.
config GPIO_MCP23017
    default y

# Enable I2C explicitly so the bus is brought up before the kscan
# probes its input-gpios.
config I2C
    default y

endif
